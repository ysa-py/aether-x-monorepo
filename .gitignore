# Rust
target/
**/*.rs.bk
# Cargo.lock IS committed (this crate ships binaries, not a library).

# Go
control-plane/coverage.out
control-plane/*.test
control-plane/vendor/

# Generated proto stubs are committed for reproducible builds; uncomment to
# ignore if you prefer to generate in CI only:
# api/gen/

# Node / Next.js (generated locally and in CI)
node_modules/
.next/
playwright-report/
test-results/
*.tsbuildinfo

# Python bytecode (never a source artifact)
__pycache__/
*.py[cod]

# Editor / OS
.vscode/
.idea/
.DS_Store
*.swp

# proptest shrunk-case pins (dev-local; tests are self-validating)
*.proptest-regressions

# Local secrets — NEVER commit
*.pem
*.key
# Public, self-signed loopback TLS fixture for live-signal unit tests only.
!core-supervisor/tests/fixtures/live_signals/*.pem
*.crt
.env
.env.*
